// {{project.name}} — generated from {{self.name}}@{{self.version}}:window
import std;
import imgui.core;
import imgui.app;

int main(int argc, char** argv) {
    const bool smoke = argc > 1 && std::string_view(argv[1]) == "--smoke-test";
    unsigned frames = 0;
    const int result = ImGui::App::run({.title = "{{project.name}}", .max_frames = smoke ? 3u : 0u}, [&] {
        ++frames;
        ImGui::Begin("{{project.name}}");
        ImGui::TextUnformatted("Hello from mcpp + imgui");
        ImGui::End();
    });
    if (smoke) std::println("Rendered {} ImGui frames", frames);
    return result != 0 ? result : (smoke && frames != 3 ? 4 : 0);
}
